{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmkarii.github.io/bash-fa-reference/schema/record.schema.json",
  "title": "Bashref reference record",
  "type": "object",
  "required": ["id", "kind", "name", "language", "summary", "synopsis", "description", "examples", "related", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9._-]*$"},
    "kind": {"enum": ["builtin", "syntax", "expansion", "option", "shopt", "variable", "concept", "example"]},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "language": {"enum": ["en", "fa"]},
    "summary": {"type": "string", "minLength": 1},
    "synopsis": {"type": "string"},
    "description": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "array"},
    "exit_status": {"type": "array"},
    "examples": {"type": "array"},
    "pitfalls": {"type": "array"},
    "portability": {"type": "array"},
    "security": {"type": "array"},
    "related": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "since": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string", "format": "uri"}}
  },
  "additionalProperties": true
}
